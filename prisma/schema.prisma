generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  MERCHANT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(BUYER)
  createdAt     DateTime  @default(now())

  carts  Cart[]
  orders Order[]
  events CustomerEvent[]

  accounts Account[]
  sessions Session[]

  merchant Merchant?

  campaignExposures CampaignExposure[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  price       Int
  currency    String   @default("INR")
  inventory   Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  merchantId String?

  merchant        Merchant?        @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  cartItems       CartItem[]
  orderItems      OrderItem[]
  customerEvents  CustomerEvent[]
  campaignTargets CampaignTarget[]

  @@index([merchantId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  checkouts Checkout[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Checkout {
  id        String   @id @default(cuid())
  cartId    String
  amount    Int
  currency  String   @default("INR")
  status    String   @default("READY")
  policy    Json?
  createdAt DateTime @default(now())

  cart     Cart      @relation(fields: [cartId], references: [id])
  payments Payment[]
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  totalAmount Int
  currency    String   @default("INR")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id])
  items            OrderItem[]
  payment          Payment?
  campaignExposure CampaignExposure?
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String?  @unique
  checkoutId        String
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  razorpaySignature String?
  idempotencyKey    String   @unique
  amount            Int
  status            String
  attempt           Int      @default(1)
  createdAt         DateTime @default(now())

  order    Order?   @relation(fields: [orderId], references: [id])
  checkout Checkout @relation(fields: [checkoutId], references: [id])

  @@index([checkoutId])
}

model AgentAction {
  id         String   @id @default(cuid())
  agentType  String
  action     String
  entityType String?
  entityId   String?
  input      Json?
  output     Json?
  status     String
  reason     String?
  createdAt  DateTime @default(now())
}

model CustomerEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  productId String?
  metadata  Json?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, eventType])
  @@index([productId, eventType])
}

model Campaign {
  id              String   @id @default(cuid())
  name            String
  type            String
  status          String   @default("DRAFT")
  description     String?
  targetAudience  String?
  discountPercent Int      @default(0)
  budget          Int      @default(0)
  expectedRevenue Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchantId String?

  merchant  Merchant?          @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  exposures CampaignExposure[]
  targets   CampaignTarget[]

  @@index([merchantId])
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products  Product[]
  campaigns Campaign[]
}

model CampaignExposure {
  id          String    @id @default(cuid())
  campaignId  String
  userId      String
  exposedAt   DateTime  @default(now())
  convertedAt DateTime?
  orderId     String?   @unique

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([campaignId, exposedAt])
  @@index([campaignId, userId])
  @@index([userId, exposedAt])
}

model CampaignTarget {
  id         String   @id @default(cuid())
  campaignId String
  productId  String
  role       String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId, role])
  @@index([productId, role])
}

model RazorpayWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  event       String
  processed   Boolean   @default(false)
  payload     Json
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([event])
  @@index([processed])
}
